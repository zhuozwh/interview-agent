# 应用显示名称，会用于 FastAPI 文档标题。
APP_NAME=Interview Agent

# 当前运行环境的标识；Phase 0 默认使用 local。
APP_ENV=local

# Python 标准日志级别。
LOG_LEVEL=INFO

# 本地 SQLite 文件路径；用于索引状态，程序真正连接数据库时才会创建文件。
# SQLite、Chroma 和模型缓存都必须与三个只读 Markdown 数据源互不重叠。
DATABASE_PATH=data/interview_agent.db

# Markdown 只读数据源；相对路径按应用启动时的工作目录解释。
MARKDOWN_SOURCE_DIRECTORY=knowledge/interview
PROJECT_SOURCE_DIRECTORY=knowledge/projects
RESUME_SOURCE_DIRECTORY=knowledge/resume

# 允许读取的数据目录 JSON 数组；数据源及每个文件的规范化路径都必须位于其中。
ALLOWED_DATA_DIRECTORIES=["knowledge"]

# 单文件和一次加载的 UTF-8 原始字节上限，避免无界读取。
MARKDOWN_MAX_FILE_SIZE_BYTES=2097152
MARKDOWN_MAX_TOTAL_SIZE_BYTES=20971520

# 当前 BGE 模型最多使用 500 字符片段，避免超过 512-token 输入上限。
MARKDOWN_CHUNK_MAX_CHARACTERS=500

# Chroma 本地持久化目录和集合名；默认目录已被 .gitignore 排除。
VECTOR_STORE_PATH=vector_index
VECTOR_COLLECTION_NAME=interview_agent_chunks

# 单次发送给 Embedding 适配器的最大文本数量。
EMBEDDING_BATCH_SIZE=64

# 本地中文 Embedding 模型和缓存目录；首次运行可下载公开模型文件。
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_DIRECTORY=embedding_models

# 模型缓存完整后可设为 true，强制离线加载并禁止缺失文件时联网下载。
EMBEDDING_LOCAL_FILES_ONLY=false

# 三个只读 Tool 分别过滤弱证据，并限制返回给 Agent 的正文总字符数。
SEARCH_NOTES_MIN_SCORE=0.58
SEARCH_NOTES_MAX_TOTAL_CHARACTERS=6000
PROJECT_CONTEXT_MIN_SCORE=0.535
PROJECT_CONTEXT_MAX_TOTAL_CHARACTERS=6000
RESUME_CONTEXT_MIN_SCORE=0.56
RESUME_CONTEXT_MAX_TOTAL_CHARACTERS=3000

# 交给后续 LLM 的完整 JSON 证据包预算，包含引用元数据和正文。
RAG_CONTEXT_MAX_CHARACTERS=8000

# OpenAI-compatible LLM；密钥留空时仍可运行健康检查和全部离线测试。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# 单 Agent 当前最多调用一个只读检索 Tool；这里限制召回数量和最终回答字符数。
AGENT_TOP_K=5
AGENT_MAX_ANSWER_CHARACTERS=8000
